# ---------------------------------------------------------------------------
# Flipkart Price Change Monitor - example environment file
#
# Copy to `.env` and adjust. Never commit the real `.env`.
#   cp .env.example .env
#
# NOTE: This application does NOT need Flipkart credentials. It only reads
# public product pages. Do not add Flipkart usernames/passwords here.
# ---------------------------------------------------------------------------

# --- HTTP server ---
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated list of allowed browser origins for the API (CORS).
CORS_ORIGIN=http://localhost:5173

# --- Database (Supabase Postgres) ---
# From your Supabase project's Settings -> API page.
# SUPABASE_SERVICE_ROLE_KEY is server-only - never expose it to the frontend,
# it bypasses Row Level Security entirely.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron-triggered price checks ---
# Shared secret the price-check workflow must send via the `x-cron-secret`
# header when calling POST /api/cron/check-prices. Generate any long random
# string, e.g.: openssl rand -hex 32
CRON_SECRET=

# --- Logging ---
# trace | debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
# Optional file to also append structured JSON logs to.
LOG_FILE=./logs/app.log

# ---------------------------------------------------------------------------
# Monitoring defaults.
# These seed the Settings table on first boot. After that, the Settings page
# in the UI is the source of truth (DB values win over env values).
# ---------------------------------------------------------------------------

# How often every monitored product is re-checked, in minutes. Default 15.
MONITOR_INTERVAL_MINUTES=15

# Global kill switch for the background scheduler.
MONITORING_ENABLED=true

# How many product checks may run at the same time.
MAX_CONCURRENT_CHECKS=3

# Per-request timeout for a single fetch attempt, in milliseconds.
REQUEST_TIMEOUT_MS=30000

# Total fetch attempts per strategy before a check is marked failed (1 = no retry).
# Only transient failures (timeout, network, 5xx) consume a retry.
FETCH_MAX_RETRIES=3

# Enable in-app notifications (the only provider shipped in v1).
NOTIFY_IN_APP=true

# --- Flipkart fetching strategy ---
# auto  -> try plain HTTP first, fall back to Playwright when needed
# http  -> plain HTTP only (fast, no browser, may miss dynamic prices)
# playwright -> always use a real browser
FETCH_STRATEGY=auto

# Run Playwright headless.
PLAYWRIGHT_HEADLESS=true

# ---------------------------------------------------------------------------
# Web Push notifications (VAPID).
#
# Generate a keypair once with:
#   npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY is safe to expose to the browser (the frontend fetches it
# from GET /api/push-subscriptions/vapid-public-key). VAPID_PRIVATE_KEY is
# server-only - never put it in any frontend code or commit it. Leave both
# blank to disable the Web Push channel; the provider is skipped when unset.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI Web Push requires in the VAPID JWT (a mailto: address or a
# URL push services may use to reach you about this application).
VAPID_SUBJECT=mailto:admin@example.com
