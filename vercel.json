{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build && node scripts/copy-web-dist.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "maxDuration": 60
    }
  }
}
